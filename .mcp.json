{
  "mcpServers": {
    "hms-acp-incident-mcp": {
      "command": "node",
      "args": [
        "${HMS_ACP_INCIDENT_MCP_HOME}/dist/index.js"
      ],
      "env": {
        "ACP_USERNAME": "${ACP_USERNAME}",
        "ACP_PASSWORD": "${ACP_PASSWORD}",
        "ACP_API_BASE_URL": "${ACP_API_BASE_URL:-https://core-acp.humansoft.co.th}",
        "ACP_API_PATH": "${ACP_API_PATH:-/api.php}",
        "ACP_API_WEB_PATH": "${ACP_API_WEB_PATH:-/api-web.php}",
        "ACP_API_TIMEOUT_MS": "${ACP_API_TIMEOUT_MS:-30000}"
      }
    }
  }
}