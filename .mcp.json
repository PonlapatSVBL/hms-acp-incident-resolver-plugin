{
  "mcpServers": {
    "hms-acp-incident-mcp": {
      "command": "node",
      "args": ["${HMS_ACP_INCIDENT_MCP_HOME}/dist/index.js"],
      "env": {
        "ACP_API_TOKEN": "${ACP_API_TOKEN}",
        "ACP_API_BASE_URL": "${ACP_API_BASE_URL:-https://api.humansoft.co.th}",
        "ACP_API_PATH": "${ACP_API_PATH:-/api.php}",
        "ACP_USER_ID": "${ACP_USER_ID:-}",
        "ACP_API_TIMEOUT_MS": "${ACP_API_TIMEOUT_MS:-30000}"
      }
    }
  }
}
